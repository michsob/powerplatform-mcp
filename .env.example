# PowerPlatform Configuration
# Copy this file to .env and fill in your actual values.
#
# The CLI / MCP server supports multiple environments. Each environment is
# identified by a short name (e.g. DEV, UAT, PROD) and needs four variables
# named POWERPLATFORM_<NAME>_URL / _CLIENT_ID / _CLIENT_SECRET / _TENANT_ID.
#
# The first name listed in POWERPLATFORM_ENVIRONMENTS is the default — used
# whenever a command or MCP tool call omits the --env / environment parameter.
# Target a non-default environment with `--env UAT` on the CLI or by passing
# `environment: "UAT"` to an MCP tool.

# --- Single environment ---------------------------------------------------
# Minimum viable config. The single environment name becomes the default.

POWERPLATFORM_ENVIRONMENTS=DEV

POWERPLATFORM_DEV_URL=https://dev-org.crm.dynamics.com
POWERPLATFORM_DEV_CLIENT_ID=00000000-0000-0000-0000-000000000000
POWERPLATFORM_DEV_CLIENT_SECRET=your-client-secret
POWERPLATFORM_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Multiple environments ------------------------------------------------
# Uncomment and adjust to manage several environments from one config. Each
# name in POWERPLATFORM_ENVIRONMENTS must have all four matching variables.
#
# POWERPLATFORM_ENVIRONMENTS=DEV,UAT,PROD
#
# POWERPLATFORM_UAT_URL=https://uat-org.crm.dynamics.com
# POWERPLATFORM_UAT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# POWERPLATFORM_UAT_CLIENT_SECRET=your-uat-client-secret
# POWERPLATFORM_UAT_TENANT_ID=00000000-0000-0000-0000-000000000000
#
# POWERPLATFORM_PROD_URL=https://prod-org.crm.dynamics.com
# POWERPLATFORM_PROD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# POWERPLATFORM_PROD_CLIENT_SECRET=your-prod-client-secret
# POWERPLATFORM_PROD_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Notes ---------------------------------------------------------------
# - Environment names are case-sensitive and become part of the variable
#   prefix, so POWERPLATFORM_ENVIRONMENTS=dev expects POWERPLATFORM_dev_URL.
#   Conventionally use uppercase short names (DEV, UAT, PROD).
# - Names may contain letters, digits, and underscores. Avoid hyphens and
#   spaces — they can't appear in env var names.
# - Each app registration must be granted access to the matching Dataverse
#   environment as an Application User with appropriate security roles.
